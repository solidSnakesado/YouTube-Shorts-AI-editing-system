# 역할: 환경변수 템플릿 .env로 복사하여 .env에서 세부내용 지정하여 사용
# 이 파일은 기본값/구조 공유 용
# app/core/config.py의 Settings 클래스가 이 환경 설정 값을 읽음
# 변수명은 Settings 클래스의 필드명과 정확히 일치해야 함
#
# 17일차 변경 사항:
#   - LLM_CTX_SIZE: 24576 -> 8192 원복 (청크 분할로 장편 영상도 8K로 처리 가능)
#   - 청크 분할 환경변수가 3대 추가 (CHUNK_*, HIGHLIGHT_IOU_THRESHOLD)
#
# 20일차 변경 사항:
#   - 히트맵 수집 환경변수 4개 추가(HEATMAP_*)
#   - YouTube "Most Replayed" 크롤러용 (파인튜닝 데이터 수집)
#
# 21일차 변경 사항:
#   - 파인튜닝 데이터 준비 환경변수 4개 추가(FINETUNE_*)
#
# 22일차 변경 사항:
#   - QLoRA 파인튜닝 환경변수 3개 추가(LORA_*)
#   - Gemma 4 E4B -> Qwen2.5-VL-7B 모델 전환 (학습 + 추론 통일)

# --------------------------------------------------------------
# 애플리케이션
# --------------------------------------------------------------
APP_NAME="YT Shorts AI"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --------------------------------------------------------------
# 데이터베이스
# --------------------------------------------------------------
# SQLite (프로토타입): sqlite+aiosqlite:///./data/shorts_ai.db
# PostgreSQL (프로덕션): postgresql+asyncpg://user:password@localhost:5432/shorts_ai
DATABASE_URL=sqlite+aiosqlite:///./data/shorts_ai.db

# --------------------------------------------------------------
# 보안 (JWT)
# --------------------------------------------------------------
# 프로덕션 배포 시 반드시 랜덤 문자열로 교채
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --------------------------------------------------------------
# AI 모델 - Whisper (faster-whisper)
# --------------------------------------------------------------
# Whisper 모델 크기별 VRAM 사용량:
#   tiny/base: 1~2GB | small/medium: 2~5GB
#   large-v3: 10~12GB | large-v3-turbo: 6~8GB(사용예정)
# RTX 5070Ti 노트북 (11.9GB)에서는 large-v3-turbo 사용 가능
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# --------------------------------------------------------------
# AI 모델 - YOLO (ultralytics, 8~10일차)
# --------------------------------------------------------------
# YOLOv8 모델 크기: n(nano, 빠름) -> s -> m -> l -> x(정밀, 느림)
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=cuda

# --------------------------------------------------------------
# AI 모델 — 로컬 LLM (Gemma 4 E4B, 6~7일차, Qwen2.5-VL-7B, 22일차 전환)
# --------------------------------------------------------------
# Gemma 4 E4B Q8_0: ~8-9GB VRAM, RTX 5070 Ti (11.9GB)에 적합
# E4B 선택 이유:
#   - 26B-A4B(UD-Q4_K_XL)는 16~8GB -> 12GB에서 fit-based 배치 필요 + OOM 위험
#   - E4B Q8_0는 ~8~9GB -> 12GB VRAM에 여유롭게 적재
#   - 128K 컨텍스트 지원, 하이라이트 추출에 충분한 성능
#
# 다운로드 방법:
#   pip install huggingface_hub hf_transfer
#   huggingface-cli download unsloth/gemma-4-E4B-it-GGUF \
#     --include "*Q8_0*" --local-dir ./models/llm/
#
# 22일차: Gemma 4 E4B -> Qwen2.5-VL-7B 전환
#   - Gemma 4E4B는 12GB VRAM에서 QLoRA 학습 불가 (4bit 웨이트만 ~8GB)
#   - Qwen2.5-VL-7B Q5_K_M: ~5.4GB, 멀티모달 벤치마크 상위, 12GB 충분
# 다운로드 방법
#   hf download unsloth/Qwen2.5-VL-7B-Instruct-GGUF \
#     --include "*Q5_K_M*" --local-dir ./models/llm/
#
# LLM_MODEL_PATH: GGUF 파일이 있는 디렉토리 (또는 직접 .gguf 파일 경로)
# LLM_MODEL_NAME: 디렉토리 내 사용할 GGUF 파일명
# LLM_N_GPU_LAYERS: -1이면 모든 레이어를 GPU에 오프로드 (12GB VRAM 충분)
# LLM_CTX_SIZE: 컨텍스트 윈도우 크기 (토큰). 
#   17일차 이후 청크 분할 구현으로 장편 영상도 8K로 처리 가능 (기본값 유지 권장)
#   값을 올리면 KV 캐시 VRAM 점유가 증가하여 스필오버 위험
LLM_MODEL_PATH=./models/llm/
# LLM_MODEL_NAME=gemma-4-E4B-it-Q8_0.gguf
LLM_MODEL_NAME=Qwen2.5-VL-7B-Instruct-Q5_K_M.gguf
LLM_N_GPU_LAYERS=-1
LLM_CTX_SIZE=8192

# --------------------------------------------------------------
# VLM 서버 — llama-server 서브프로세스 (14일차 추가, 22일차 Qwen2.5-VL 전환)
# --------------------------------------------------------------
# llama-server 네이티브 바이너리로 Gemma 4 멀티모달(텍스트 + 이미지) 추론
# llama-cpp-python 대신 서브프로세스 방식 채택:
#   - llama.cpp 최신 libmtmd 멀티모달 지원 활용
#   - 프로세스 종료 시 VRAM이 OS 수준에서 완전 해제
#   - OpenAI 호환 API(/v1/chat/completions) -> 기존 코드 재활용
#
# llama-server 빌드 방법
#   git clone https://github.com/ggml-org/llama.cpp
#   cmake llama.cpp -B llama.cpp/build \
#       -DBUILD_SHARED_LIBS=OFF -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=120
#   cmake --build llama.cpp/build --config Release -j --target llama-server
#   cp llama.cpp/build/bin/llama-server ./bin/llama-server
#
# mmproj 다운로드 방법 (~800MB):
#   huggingface-cli download unsloth/gemma-4-E4B-it-GGUF \
#       --local-dir ./models/llm/ --include "*mmproj*"
#
# llama-server로 Qwen2.5-VL-7B 멀티모달(텍스트 + 이미지) 추론
# 서브프로세스 방식:
#   - llama.cpp 최신 멀티모달 지원 활용
#   - 프로세스 종료 시 VRAM이 OS 수준에서 완전 해제
#   - OpenAI 호환 API(/v1/chat/completions) -> 기존 코드 재활용
#
# llama-server 빌드 방법:
#   git clone https://github.com/ggml-org/llama.cpp
#   cmake llama.cpp -B llama.cpp/build \
#       -DBUILD_SHARED_LIBS=OFF -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=120
#   cmake --build llama.cpp/build --config Release -j --target llama-server
#   cp llama.cpp/build/bin/llama-server ./bin/llama-server
#
# mmproj 다운로드 방법:
#   hf download unsloth/Qwen2.5-VL-7B-Instruct-GGUF \
#       --include "*mmproj*" --local-dir ./models/llm/
LLAMA_SERVER_PATH=./bin/llama-server
MMPROJ_MODEL_NAME=mmproj-BF16.gguf
LLM_SERVER_HOST=127.0.0.1
LLM_SERVER_PORT=8090
LLM_SERVER_TIMEOUT=60

# --------------------------------------------------------------
# 프레임 추출 — VLM 멀티모달 입력용 (14일차 추가, 22일차 Qwen2.5-VL 대응)
# --------------------------------------------------------------
# Gemma 4 비주얼 토큰 예산:
#   560px -> 프레임당 ~280토큰 -> 20프레임 = ~5,600토큰 (일반 분석)
#   1120px -> 프레임당 ~1,120토큰 -> 10프레임 = ~11,200토큰 (OCR/세부)
# Qwen2.5-VL 비주얼 토큰 예산:
#   기본 토큰 범위 4~16384, min_pixels/max_pixels로 제어
#   560px -> 프레임당 ~200~300토큰 -> 20프레임 = ~4,000~6,000토큰
FRAME_EXTRACT_INTERVAL_SEC=10.0
FRAME_EXTRACT_MAX_FRAMES=20
FRAME_EXTRACT_RESOLUTION=560

# --------------------------------------------------------------
# 청크 분할 (17일차 추가) - 장편 영상 대응
# --------------------------------------------------------------
# 전사 결과를 시간 단위로 분할하여 각 청크별로 LLM 하이라이트 추출
# 이후 재랭킹(IoU 기반 시간 겹침 제거)으로 최종 하이라이트 선정
#
# CHUNK_DURATION_SEC: 청크 기본 길이 (초), 600초(10분)면 프롬프트가 약 5K토큰 -> 8K 컨텍스트 안정
# CHUNK_OVERLAP_SEC: 청크 간 오버랩 (초), 30초면 경계에 걸친 발화 단락 유실 방지 (앞뒤 각 15초)
# HIGHLIGHT_IOU_THRESHOLD: 시간 겹침 판정 기준 (0.0 ~ 1.0), 0.3이면 30% 이상 겹치면 동일 하이라이트
CHUNK_DURATION_SEC=600.0
CHUNK_OVERLAP_SEC=30.0
HIGHLIGHT_IOU_THRESHOLD=0.3

# --------------------------------------------------------------
# 히트맵 수집 (20일차 추가) - YouTube "Most Replayed" 크롤러
# --------------------------------------------------------------
# 목적: YouTube 시청자 행동 기반 히트맵을 다수 영상에서 수집
#      21일차 멀티모달 파인튜닝 데이터셋의 라벨(정답)로 활용
# 동작: yt-dlp의 info.heatmap 필드(InnerTube API 파싱)를 통해 추출
#      공식 YouTube Data API에서는 히트맵이 노출되지 않음
# HEATMAP_OUTPUT_DIR: 수집 결과 JSONL 파일 저장 경로 (영상별 1라인)
# HEATMAP_RATE_LIMIT_SEC: 영상 간 호출 간격(초), IP 차단 회피
# HEATMAP_MIN_DURATION_SEC: 이 길이 미만 영상은 히트맵 노이즈가 심하므로 스킵
# HEATMAP_REQUEST_TIMEOUT_SEC: yt-dlp metadata 호출 타임아웃
HEATMAP_OUTPUT_DIR=./data/heatmaps
HEATMAP_RATE_LIMIT_SEC=2.0
HEATMAP_MIN_DURATION_SEC=60.0
HEATMAP_REQUEST_TIMEOUT_SEC=30

# --------------------------------------------------------------
# 파인튜닝 데이터 준비 (21일차 추가) - VLM 멀티모달 학습
# --------------------------------------------------------------
# 히트맵 피크 구간의 프레임을 추출하여 포지티브/네거티브 학습 데이터 생성
# 산출물(dataset.jsonl) -> 22일차 Unsloth QLoRA 파인튜닝 입력
# FINETUNE_OUTPUT_DIR: 데이터셋 JSONL + frames/ 서브디렉토리 저장 루트
# FINETUNE_FRAMES_PER_SEGMENT: 하나의 피크/비피크 세그먼트에서 추출할 프레임 수
# FINETUNE_NEGATIVE_RATIO: 포지티브 1개당 네거티브 샘플 비율 (1.0 = 1:1)
# FINETUNE_MIN_PEAK_COUNT: 이 수 미만 피크를 가진 영상은 처리 대상에서 제외
FINETUNE_OUTPUT_DIR=./data/finetune
FINETUNE_FRAMES_PER_SEGMENT=5
FINETUNE_NEGATIVE_RATIO=1.0
FINETUNE_MIN_PEAK_COUNT=2

# --------------------------------------------------------------
# QLoRA 파인튜닝 (22일차 추가) - Unsloth LoRA 어댑터
# --------------------------------------------------------------
# 학습 완료 후 adapter/ 디렉토리에 LoRA 가중치 저장 (~100MB)
# LORA_ENABLED=true 로 전환하면 추론 시 파인튜닝된 모델 사용
#
# 학습 실행:
#   uv run python -m scripts.train_qlora --epochs 3
#
# 사전 설치
#   pip install unsloth trl datasets pillow --break-system-packages
# LORA_BASE_MODEL=unsloth/gemma-4-E4B-it
LORA_BASE_MODEL=unsloth/Qwen2.5-VL-7B-Instruct-unsloth-bnb-4bit
LORA_OUTPUT_DIR=./models/lora/heatmap_adapter
LORA_GENERATOR_DIR=./models/lora/heatmap_generator                         
LORA_ENABLED=true

# --------------------------------------------------------------
# 외부 API (선택)
# --------------------------------------------------------------
# 비어있으면 로컬 llm 사용, 값이 있으면 OpenAI API 사용
OPENAI_API_KEY=

# --------------------------------------------------------------
# 영상 처리
# --------------------------------------------------------------
OUTPUT_DIR=./outputs
TEMP_DIR=./temp
MAX_VIDEO_DURATION_MIN=120
DEFAULT_SHORTS_DURATION_SEC=60
VIDEO_QUALITY=1080

# --------------------------------------------------------------
# FFmpeg (GPU 가속 인코딩)
# --------------------------------------------------------------
# NVENC 프리셋: p1(최고속) ~ p7(최고품질), p4가 균형점
# CQ 품질 지수: 낮을 수록 고품질 (18~28 권장)
FFMPEG_HWACCEL=cuda
NVENC_PRESET=p4
NVENC_CQ=23

# --------------------------------------------------------------
# 로깅
# --------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=./logs/app.log