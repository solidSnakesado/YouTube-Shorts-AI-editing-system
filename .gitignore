# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# --- AI & Media Processing (대용량 파일 방지) ---
# 다운로드된 원본 영상 + 중간 처리 파일
temp/

# 완성된 쇼츠 영상
outputs/

# 영상/오디오 파일
*.mp4
*.mkv
*.avi
*.mov
*.wav
*.mp3
*.flac

# 자막 파일
*.ass
*.srt

# AI 모델 가중치 (Gemma 4, Whisper, YOLO 등)
models/
weights/
*.pth
*.bin
*.onnx
*.ckpt
*.gguf
*.safetensors

# --- Database & Logs ---
# SQLite 데이터베이스
data/
*.db
*.db-journal

# 로그 파일
logs/
*.log

# --- Environment & Security (보안 필수) ---
# API Key, DB 접속 정보 등 환경 변수
.env
.env.local
secrets.json

# --- HuggingFace 캐시 ---
.huggingface/
hf_transfer/

# --- OS & IDE (작업 환경 최적화) ---
# macOS
.DS_Store
# Windows (WSL2 혼용 시)
Thumbs.db
desktop.ini

# IDE Settings (개인 설정 제외)
.vscode/
.idea/

# uv 패키지 관리자 캐시/잠금
.uv_cache/

# PyTorch / CUDA 캐시
torch_extensions/
*.pt

# Whisper 모델 캐시 (faster-whisper 자동 다운로드)
.cache/

# YOLO 런타임 생성 파일
runs/

# Jupyter (개발 중 사용 시)
.ipynb_checkpoints/
*.ipynb

# pytest 캐시
.pytest_cache/
htmlcov/
.coverage

# --- 학습 데이터셋 (생성물 — 빌더로 재생성, 대용량 6.6GB) ---
# datasets/ = jsonl + frames(~13만 jpg) + audio
datasets/
# 프레임/썸네일 이미지
*.jpg
*.jpeg
*.png
*.webp
# 데이터 압축본 (Colab 업로드용 tar)
*.tar
*.tar.gz
*.zip
